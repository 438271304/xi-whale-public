  },
  "updates": {
    "policy": "validated-versions-only",
    "installed_auto_update_disabled": false
  },
  "permissions": {
    "public_posting": false,
    "stranger_dm": false,
    "payments": false,
    "independent_workspace": true,
    "test_messages_to_family_or_father": true,
    "friend_requests_auto_accept": false,
    "add_friend_requires_guardian_approval": true
  },
  "notes": [
